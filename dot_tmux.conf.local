# : << 'EOF'
# Oh my tmux! local configuration
# https://github.com/gpakosz/.tmux
# Dual licensed under WTFPL v2 and MIT; Copyright 2012— Gregory Pakosz.
#
# Edit the chezmoi source, apply ~/.tmux.conf.local, then reload with Ctrl+b r.
# tmux_conf_* variables configure Oh my tmux!; set/bind are native tmux commands.
# Machine-only overrides belong in ~/.config/tmux.conf.local.

# -- Session and pane behavior -------------------------------------------------
tmux_conf_preserve_stock_bindings=false
tmux_conf_new_session_prompt=false
tmux_conf_new_session_retain_current_path=false
tmux_conf_new_window_retain_current_path=false
tmux_conf_new_window_reconnect_ssh=false
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false
tmux_conf_24b_colour=auto

# -- Colors -------------------------------------------------------------------
# Neutral gray with blue for the active window; 256-color terminals are enough.
tmux_conf_theme=enabled

tmux_conf_theme_colour_1="colour234"   # status background
tmux_conf_theme_colour_2="colour238"   # inactive border
tmux_conf_theme_colour_3="colour250"   # dim foreground
tmux_conf_theme_colour_4="colour111"   # accent blue
tmux_conf_theme_colour_5="colour221"   # warning amber
tmux_conf_theme_colour_6="colour234"   # status left fg fallback
tmux_conf_theme_colour_7="colour255"   # bright foreground
tmux_conf_theme_colour_8="colour234"   # status left bg fallback
tmux_conf_theme_colour_9="colour111"
tmux_conf_theme_colour_10="colour238"
tmux_conf_theme_colour_11="colour111"
tmux_conf_theme_colour_12="colour250"  # right segment fg
tmux_conf_theme_colour_13="colour255"  # right segment fg strong
tmux_conf_theme_colour_14="colour234"  # right segment bg strong
tmux_conf_theme_colour_15="colour234"
tmux_conf_theme_colour_16="colour221"
tmux_conf_theme_colour_17="colour234"

# -- Panes, prompts and selection ---------------------------------------------
tmux_conf_theme_window_fg="default"
tmux_conf_theme_window_bg="default"

tmux_conf_theme_highlight_focused_pane=false

tmux_conf_theme_focused_pane_bg="default"

tmux_conf_theme_pane_border_style=thin

tmux_conf_theme_pane_border="$tmux_conf_theme_colour_2"
tmux_conf_theme_pane_active_border="$tmux_conf_theme_colour_4"
%if #{>=:#{version},3.2}
tmux_conf_theme_pane_active_border="#{?pane_in_mode,$tmux_conf_theme_colour_9,#{?synchronize-panes,$tmux_conf_theme_colour_16,$tmux_conf_theme_colour_4}}"
%endif

tmux_conf_theme_pane_indicator="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_active_indicator="$tmux_conf_theme_colour_4"

tmux_conf_theme_message_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_message_attr="bold"

tmux_conf_theme_message_command_fg="$tmux_conf_theme_colour_4"
tmux_conf_theme_message_command_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_command_attr="bold"

tmux_conf_theme_mode_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_mode_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_mode_attr="bold"

# -- Window labels ------------------------------------------------------------
# Keep previous windows neutral; underline activity and show bells without blink.
tmux_conf_theme_status_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_status_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_status_attr="none"

tmux_conf_theme_terminal_title="#h / #S / #I:#W"

tmux_conf_theme_window_status_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_window_status_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_window_status_format=" #I:#{=24:window_name}#{?window_bell_flag, !,} "

tmux_conf_theme_window_status_current_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_current_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format="$tmux_conf_theme_window_status_format"

tmux_conf_theme_window_status_activity_fg="default"
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="underscore"

tmux_conf_theme_window_status_bell_fg="$tmux_conf_theme_colour_5"
tmux_conf_theme_window_status_bell_bg="default"
tmux_conf_theme_window_status_bell_attr="bold"

tmux_conf_theme_window_status_last_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_window_status_last_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_last_attr="none"

# -- Status bar ---------------------------------------------------------------
# Session | windows ... active modes, short hostname and time.
# Bound names to leave room for windows. No Powerline or Nerd Font required.
# Mode labels appear only when relevant; mouse-on is the normal state.
tmux_conf_theme_left_separator_main=''
tmux_conf_theme_left_separator_sub=' / '
tmux_conf_theme_right_separator_main=''
tmux_conf_theme_right_separator_sub=' / '

tmux_conf_theme_status_left=" #{=18:session_name} /"
tmux_conf_theme_status_right="#{?client_prefix, PREFIX ,}#{?pane_in_mode, COPY ,}#{?window_zoomed_flag, ZOOM ,}#{?pane_synchronized, SYNC ,}#{?session_many_attached, SHARED ,}#{?mouse,, MOUSE OFF } #{=20:host_short}  %H:%M "

tmux_conf_theme_status_left_fg="$tmux_conf_theme_colour_4"
tmux_conf_theme_status_left_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_status_left_attr="bold"

tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_status_right_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_status_right_attr="none"

tmux_conf_theme_clock_colour="$tmux_conf_theme_colour_4"
tmux_conf_theme_clock_style="24"

# -- Clipboard and URL scanning -----------------------------------------------
tmux_conf_copy_to_os_clipboard=true

tmux_conf_urlscan_options="--compact --dedupe"

# -- Keys and general options -------------------------------------------------
# Ctrl+b r reloads; Ctrl+b | and Ctrl+b - split in the current directory.
set -g history-limit 100000

set -g mouse on

# Open right-click menus on release; keep them open until a fresh click or Escape.
# Preserve default menus across reloads and forward presses to mouse-aware apps.
if-shell -F '#{==:#{@right_click_menu_on_mouse_up},}' {
  run-shell 'tmux list-keys -T root | grep " MouseDown3Pane " | sed "s/ MouseDown3Pane / MouseUp3Pane /" | tmux source-file -'
  set -g @right_click_menu_on_mouse_up 1
}
run-shell 'tmux list-keys -T root | grep " MouseUp3Pane " | sed "/display-menu -O /! s/display-menu /display-menu -O /" | tmux source-file -'
bind-key -T root MouseDown3Pane if-shell -F -t = \
  '#{||:#{mouse_any_flag},#{&&:#{pane_in_mode},#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}}}' \
  { select-pane -t = ; send-keys -M } \
  { select-pane -t = }

# The window list and session label have separate right-click menus.
if-shell -F '#{==:#{@right_click_status_menu_on_mouse_up},}' {
  run-shell 'tmux list-keys -T root | grep " MouseDown3Status " | sed "s/ MouseDown3Status / MouseUp3Status /" | tmux source-file -'
  run-shell 'tmux list-keys -T root | grep " MouseDown3StatusLeft " | sed "s/ MouseDown3StatusLeft / MouseUp3StatusLeft /" | tmux source-file -'
  set -g @right_click_status_menu_on_mouse_up 1
}
run-shell 'tmux list-keys -T root | grep -E " MouseUp3(Status|StatusLeft) " | sed "/display-menu -O /! s/display-menu /display-menu -O /" | tmux source-file -'
unbind-key -T root MouseDown3Status
unbind-key -T root MouseDown3StatusLeft

set -g status-keys vi
set -g mode-keys vi

set -g renumber-windows on

set -sg escape-time 10

bind r source-file ~/.tmux.conf \; display-message 'tmux config reloaded'
bind | split-window -h -c '#{pane_current_path}'
bind - split-window -v -c '#{pane_current_path}'

# Keep Ctrl+b as the only prefix so Ctrl+a remains available to the shell.
unbind C-a
set-option -g prefix2 None

bind m set -g mouse \; display-message 'mouse #{?mouse,on,off}'

# -- Plugins and copying ------------------------------------------------------
# Oh my tmux! manages TPM. Ctrl+b I installs; Ctrl+b u updates plugins.
tmux_conf_update_plugins_on_launch=true
tmux_conf_update_plugins_on_reload=true
tmux_conf_uninstall_plugins_on_reload=true

set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'

set -g @yank_action 'copy-pipe'       # Keyboard y keeps copy mode open.
set -g @yank_with_mouse 'on'          # Enable tmux-yank mouse copying.
set -g @yank_selection_mouse 'clipboard'
bind-key -T copy-mode-vi DoubleClick1Pane \
    select-pane \; send-keys -X select-word \; \
    send-keys -X copy-selection
bind-key -T copy-mode-vi TripleClick1Pane \
    select-pane \; send-keys -X select-line \; \
    send-keys -X copy-selection

# -- Machine-only overrides ---------------------------------------------------
# Optional and deliberately outside chezmoi management.
source-file -q ~/.config/tmux.conf.local

# Required Oh my tmux! shell wrapper; keep these markers commented.
# EOF
# "$@"

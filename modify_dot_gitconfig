#!/bin/sh

set -eu

DEFAULT_NAME='rensilin'
DEFAULT_EMAIL='scgyrsl@gmail.com'
DEFAULT_LG="log --color --graph --pretty=format:'%C(bold yellow)%h%Creset -%C(auto)%d%Creset %s %C(green)(%cr) %C(bold cyan)<%an>%Creset' --abbrev-commit"
INPUT=$(mktemp "${TMPDIR:-/tmp}/chezmoi-gitconfig.XXXXXX")

cleanup() {
	rm -f -- "$INPUT"
}

trap cleanup EXIT HUP INT TERM
cat >"$INPUT"

command -v git >/dev/null 2>&1 || {
	printf 'chezmoi: git is required to update ~/.gitconfig\n' >&2
	exit 1
}

has_nonempty_value() {
	STATUS=0
	VALUE=$(git config --includes --file "$INPUT" --get "$1" 2>/dev/null) || STATUS=$?
	case "$STATUS" in
	0) [ -n "$VALUE" ] ;;
	1) return 1 ;;
	*)
		printf 'chezmoi: cannot parse ~/.gitconfig while checking %s\n' "$1" >&2
		exit "$STATUS"
		;;
	esac
}

ADD_NAME=0
ADD_EMAIL=0
ADD_LG=0
has_nonempty_value user.name || ADD_NAME=1
has_nonempty_value user.email || ADD_EMAIL=1
has_nonempty_value alias.lg || ADD_LG=1

# Preserve an already complete file byte-for-byte. Existing identities and
# aliases are machine-owned and always take precedence over these defaults.
cat "$INPUT"
if [ "$ADD_NAME" -eq 0 ] && [ "$ADD_EMAIL" -eq 0 ] && [ "$ADD_LG" -eq 0 ]; then
	exit 0
fi

if [ -s "$INPUT" ]; then
	printf '\n'
fi

if [ "$ADD_NAME" -eq 1 ] || [ "$ADD_EMAIL" -eq 1 ]; then
	printf '[user]\n'
	if [ "$ADD_NAME" -eq 1 ]; then
		printf '\tname = %s\n' "$DEFAULT_NAME"
	fi
	if [ "$ADD_EMAIL" -eq 1 ]; then
		printf '\temail = %s\n' "$DEFAULT_EMAIL"
	fi
fi

if [ "$ADD_LG" -eq 1 ]; then
	if [ "$ADD_NAME" -eq 1 ] || [ "$ADD_EMAIL" -eq 1 ]; then
		printf '\n'
	fi
	printf '[alias]\n'
	printf '\tlg = %s\n' "$DEFAULT_LG"
fi

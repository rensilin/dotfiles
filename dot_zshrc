# chezmoi: managed-zshrc
# Shared Zsh configuration for macOS and Linux. Machine-specific paths and
# environment variables belong in the unmanaged local configuration.

if [[ -n ${ZDOTDIR:-} ]]; then
	zsh_local_config=$ZDOTDIR/local.zsh
elif [[ -n ${XDG_CONFIG_HOME:-} ]]; then
	zsh_local_config=$XDG_CONFIG_HOME/zsh/local.zsh
else
	zsh_local_config=~/.config/zsh/local.zsh
fi

# A pre-existing .zshrc is migrated verbatim. Load it as the complete local
# configuration so frameworks and plugins from that file are not initialized
# a second time by the shared defaults below.
zsh_local_first_line=
if [[ -r $zsh_local_config ]]; then
	IFS= read -r zsh_local_first_line < $zsh_local_config || true
	if [[ $zsh_local_first_line == '# chezmoi: migrated-zshrc' ]]; then
		source $zsh_local_config
		unset zsh_local_config zsh_local_first_line
		return
	fi
fi

# Use Neovim when available, while allowing minimal servers to fall back to vi.
if (( $+commands[nvim] )); then
	export EDITOR=nvim
	export VISUAL=nvim
	alias vim=nvim
else
	export EDITOR=vi
	export VISUAL=vi
fi

# Oh My Zsh is managed as a chezmoi external. Keep this file usable if the
# external has not been downloaded yet or the machine is temporarily offline.
if [[ -z ${ZSH:-} ]]; then
	ZSH=~/.oh-my-zsh
fi
export ZSH
ZSH_THEME=ys
plugins=(git)

if [[ -r $ZSH/oh-my-zsh.sh ]]; then
	source $ZSH/oh-my-zsh.sh
else
	autoload -Uz compinit
	compinit -i
fi

# A normal local.zsh acts as an override layered on top of the shared defaults.
if [[ -r $zsh_local_config ]]; then
	source $zsh_local_config
fi
unset zsh_local_config zsh_local_first_line

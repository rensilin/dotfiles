# : << 'EOF'
# Oh my tmux! 个人覆盖
# 配色跟随上游，分隔符采用 README 演示图的 Powerline 样式。
# 修改 chezmoi 源文件后 apply，再按 Ctrl+b r 重载。

# -- 上游默认值 --
# 该目录由 chezmoi externals 管理，与加载入口使用同一份上游。
source-file ~/.local/share/tmux/oh-my-tmux/.tmux.conf.local

# -- 官方演示图的分隔符 --
# 上游默认不启用箭头；用命令确保覆盖发生在 source-file 之后。
set-environment -g tmux_conf_theme_left_separator_main ''
set-environment -g tmux_conf_theme_left_separator_sub ''
set-environment -g tmux_conf_theme_right_separator_main ''
set-environment -g tmux_conf_theme_right_separator_sub ''

# -- 常用操作 --
set -g history-limit 100000
set -g mouse on
set -g mode-keys vi
# 用命令设置，确保在上面的 source-file 执行后覆盖默认值。
set-environment -g tmux_conf_copy_to_os_clipboard true

# 只使用 Ctrl+b 前缀，将 Ctrl+a 留给应用。
unbind C-a
set -g prefix2 None

# 增加 | 作为左右分屏键；上游已有 - 上下分屏，并默认继承当前目录。
bind | split-window -h -c '#{pane_current_path}'

# -- 右键菜单 --
# 松开右键后打开菜单，下一次点击或 Escape 才关闭。
# 标记变量防止重载时重复改写；应用需要鼠标事件时仍将右键传给应用。
if-shell -F '#{==:#{@right_click_menu_on_mouse_up},}' {
  run-shell 'tmux list-keys -T root | grep " MouseDown3Pane " | sed "s/ MouseDown3Pane / MouseUp3Pane /" | tmux source-file -'
  set -g @right_click_menu_on_mouse_up 1
}
run-shell 'tmux list-keys -T root | grep " MouseUp3Pane " | sed "/display-menu -O /! s/display-menu /display-menu -O /" | tmux source-file -'
bind-key -T root MouseDown3Pane if-shell -F -t = \
  '#{||:#{mouse_any_flag},#{&&:#{pane_in_mode},#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}}}' \
  { select-pane -t = ; send-keys -M } \
  { select-pane -t = }

# 窗口标签和会话名称分别使用各自的右键菜单。
if-shell -F '#{==:#{@right_click_status_menu_on_mouse_up},}' {
  run-shell 'tmux list-keys -T root | grep " MouseDown3Status " | sed "s/ MouseDown3Status / MouseUp3Status /" | tmux source-file -'
  run-shell 'tmux list-keys -T root | grep " MouseDown3StatusLeft " | sed "s/ MouseDown3StatusLeft / MouseUp3StatusLeft /" | tmux source-file -'
  set -g @right_click_status_menu_on_mouse_up 1
}
run-shell 'tmux list-keys -T root | grep -E " MouseUp3(Status|StatusLeft) " | sed "/display-menu -O /! s/display-menu /display-menu -O /" | tmux source-file -'
unbind-key -T root MouseDown3Status
unbind-key -T root MouseDown3StatusLeft

# -- 插件与复制 --
# 沿用现有插件安装目录，迁移配置时无需重新安装。
set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.tmux/plugins"
# yank 保留复制行为。
# 安装、更新策略使用上游默认值。
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @yank_action 'copy-pipe'          # 复制后留在复制模式
set -g @yank_selection_mouse 'clipboard'

# 双击复制单词，三击复制整行。
bind-key -T copy-mode-vi DoubleClick1Pane \
    select-pane \; send-keys -X select-word \; \
    send-keys -X copy-selection
bind-key -T copy-mode-vi TripleClick1Pane \
    select-pane \; send-keys -X select-line \; \
    send-keys -X copy-selection

# -- 本机覆盖 --
# 不由 chezmoi 管理；文件不存在时静默跳过。
source-file -q ~/.config/tmux/tmux.conf.local2

# Oh my tmux! 的 shell 标记，请保持注释形式。
# EOF
# "$@"
